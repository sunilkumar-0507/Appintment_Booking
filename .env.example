# ---------------------------------------------------------------------------
# BarberFlow — environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# When true the app is served entirely by the in-memory mock repositories.
# When false every repository call goes through Axios to VITE_API_BASE_URL.
VITE_USE_MOCK_API=true

# Base URL of the REST API (used when VITE_USE_MOCK_API=false)
VITE_API_BASE_URL=https://api.example.com/api

# Branding
VITE_APP_NAME=BarberFlow

# Internationalisation defaults (overridable at runtime in Settings)
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_TIMEZONE=America/New_York
